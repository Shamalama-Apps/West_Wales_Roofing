---
layout: base.njk
pageType: work
title: Recent work
description: Roofs Will has worked on. Re-roofs, flat roofs, chimney rebuilds, fire and storm damage across west Wales, Swansea and Cardiff.
permalink: /work/index.html
---
{% set jobs = collections.jobs %}

<div class="wrap page-head">
  <div>
    <div class="eyebrow">Portfolio</div>
    <h1>Recent work</h1>
  </div>
  <div class="count">{{ jobs.length }} jobs, newest first <span class="kbd-hint">&middot; use the arrows or &larr; &rarr; keys</span></div>
</div>

<div class="wrap">
  <p class="lede-narrow">These are roofs {{ site.owner }} has worked on. Most were contracted through established firms, which is how the trade is learned and how most roofers work. {{ site.name }} is his own business now, and the standard on the roof is the same whoever the job is booked through.</p>
</div>

<section class="carousel" data-carousel aria-roledescription="carousel" aria-label="Recent jobs">
  <div class="carousel-nav">
    <button type="button" class="cbtn" data-prev aria-label="Previous job">&#8249;</button>
    <button type="button" class="cbtn" data-next aria-label="Next job">&#8250;</button>
  </div>
  {% for job in jobs %}
  <div class="slide{% if loop.first %} is-active{% endif %}" data-slide role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ jobs.length }}">
    <div class="slide-note">{{ job.data.photoLabel }}</div>
    {% if job.data.hero %}<img class="slide-img" src="{{ job.data.hero }}" alt="{{ job.data.title }}" sizes="100vw" loading="{% if loop.first %}eager{% else %}lazy{% endif %}">{% endif %}
    <div class="wrap slide-in">
      <div class="slide-card">
        <div class="eyebrow eyebrow-red">{{ job.data.category }}</div>
        <h2>{{ job.data.title }}</h2>
        <p>{{ job.data.overview }}</p>
        <div class="slide-specs">
          {% if job.data.system %}<div><div class="k">System</div><div class="v">{{ job.data.system }}</div></div>{% endif %}
          {% if job.data.size %}<div><div class="k">Size</div><div class="v">{{ job.data.size }}</div></div>{% endif %}
          {% if job.data.duration %}<div><div class="k">On site</div><div class="v">{{ job.data.duration }}</div></div>{% endif %}
        </div>
        <a class="btn btn-red" href="{{ job.url }}">See this job &rarr;</a>
      </div>
      <div class="slide-count">{{ loop.index | pad }} / {{ jobs.length | pad }}</div>
    </div>
  </div>
  {% endfor %}
</section>

<div class="wrap dots">
  {% for job in jobs %}
  <button type="button" class="dot{% if loop.first %} is-on{% endif %}" data-dot aria-label="Go to job {{ loop.index }}: {{ job.data.title }}"></button>
  {% endfor %}
</div>

<div class="wrap textwill">
  <div class="textwill-in">
    <div class="textwill-img"><span>portrait: {{ site.owner }}</span></div>
    <div class="textwill-body">
      <div>
        <div class="eyebrow eyebrow-red">Does your roof need our help?</div>
        <h2>Give {{ site.owner }} a ring.</h2>
        <p>He will come and look at it, tell you what it needs, and put a price in writing. Looking costs nothing, and he answers the same day.</p>
      </div>
      <div class="textwill-actions">
        <a class="btn btn-red" href="tel:{{ site.phoneLink }}">Call {{ site.phoneDisplay }}</a>
        <a class="btn btn-line" href="sms:{{ site.phoneLink }}">Send a text</a>
      </div>
    </div>
  </div>
</div>

<script src="/assets/carousel.js?v={{ build.assetHash }}" defer></script>
