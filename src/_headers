# Read from the build output by Cloudflare Workers static assets.
# Comments must sit at the start of a line, outside a rule block.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# frame-ancestors supersedes X-Frame-Options and, unlike it, can name a second
# origin: the Shamalama case study embeds a live preview of this site. Everyone
# else is still refused, so clickjacking protection is intact.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://shamalama.co.uk
