# Cloudflare Pages reads this from the build output. Replaces the [[headers]]
# blocks that were in netlify.toml.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # frame-ancestors supersedes X-Frame-Options and, unlike it, can name a second
  # origin: the studio site embeds a live preview of this site in its case study.
  # Everyone else is still refused, so clickjacking protection is intact.
  Content-Security-Policy: frame-ancestors 'self' https://shamalama.co.uk
