---
layout: base.njk
pageType: contact
title: Contact
description: Ring or text and Will answers the same day. Coming to look costs nothing. Roofing across Carmarthenshire, Pembrokeshire and Ceredigion.
permalink: /contact/index.html
---
<div class="wrap contact-top">
  <div class="eyebrow eyebrow-red">Contact</div>
  <h1>Let us know what needs doing</h1>
  <p class="lede">Ring or text and {{ site.owner }} answers the same day. Send the form and he replies within one business day. Either way, coming to look costs nothing.</p>

  <div class="contact-grid">
    <div class="contact-side">
      <h2 class="vh">Other ways to reach us</h2>
      <a class="ccard primary" href="tel:{{ site.phoneLink }}" aria-label="Call {{ site.phoneDisplay }}">
        <span class="ccard-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg></span>
        <span class="ccard-body">
          <span class="v">{{ site.phoneDisplay }}</span>
        </span>
      </a>
      <a class="ccard" href="sms:{{ site.phoneLink }}" aria-label="Send a text to {{ site.phoneDisplay }}">
        <span class="ccard-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg></span>
        <span class="ccard-body">
          <span class="v">Send a text</span>
        </span>
      </a>
      {%- if site.whatsapp %}
      <a class="ccard" href="https://wa.me/{{ site.whatsapp }}" rel="noopener" aria-label="Message {{ site.owner }} on WhatsApp">
        <span class="ccard-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15s-.77.97-.94 1.16c-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.7.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.34M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.89-9.89 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.43 9.89-9.88 9.89"/></svg></span>
        <span class="ccard-body">
          <span class="v">Message on WhatsApp</span>
        </span>
      </a>
      {%- endif %}
      <a class="ccard" href="mailto:{{ site.email }}" aria-label="Email {{ site.email }}">
        <span class="ccard-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></span>
        <span class="ccard-body">
          <span class="v">{{ site.email }}</span>
        </span>
      </a>
    </div>

    <div class="contact-main">
      <h2 class="vh">Send an enquiry</h2>
      <form name="enquiry" method="POST" data-netlify="true" netlify-honeypot="company" action="/thanks/">
        <input type="hidden" name="form-name" value="enquiry">
        <p hidden><label>Leave this empty: <input name="company"></label></p>

        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" name="name" required autocomplete="name" placeholder="Name">
        </div>
        <div class="field-row">
          <div class="field">
            <label for="c-phone">Phone</label>
            <input id="c-phone" name="phone" type="tel" required autocomplete="tel" placeholder="07&hellip;">
          </div>
          <div class="field">
            <label for="c-email">Email</label>
            <input id="c-email" name="email" type="email" autocomplete="email" placeholder="you@&hellip;">
          </div>
        </div>
        <div class="field">
          <label for="c-addr">Where is the roof?</label>
          <input id="c-addr" name="address" autocomplete="street-address" placeholder="Street, town, postcode">
        </div>
        <div class="field-row">
          <div class="field">
            <label for="c-type">Type of job</label>
            <select id="c-type" name="type">
              <option value="">Not sure yet</option>
              {% for s in site.services %}<option>{{ s.name }}</option>{% endfor %}
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="c-when">How soon?</label>
            <select id="c-when" name="when">
              <option value="">Please choose</option>
              <option>It's leaking now</option>
              <option>Within a month</option>
              <option>Next few months</option>
              <option>Just after a price</option>
              <option>No rush</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="c-msg">Description</label>
          <textarea id="c-msg" name="message" rows="5" placeholder="Slipped slates, damp patch on the ceiling, full re-roof&hellip;"></textarea>
        </div>
        <div class="form-foot">
          <button class="btn btn-red" type="submit">Send enquiry</button>
          <span class="form-note">No newsletters, no passing your details on. See our <a href="/privacy/">privacy policy</a>.</span>
        </div>
        <p class="form-urgent">{{ site.owner }} replies to enquiries within one business day. If the roof is leaking right now, ring <a href="tel:{{ site.phoneLink }}">{{ site.phoneDisplay }}</a> instead.</p>
      </form>
    </div>
  </div>
</div>

<script src="/assets/form.js?v={{ build.assetHash }}" defer></script>
