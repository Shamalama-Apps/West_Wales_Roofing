---
layout: base.njk
pageType: contact
title: Contact
description: Ring, text or send an enquiry. Will answers the same day and coming to look costs nothing. Covering Carmarthenshire, Pembrokeshire and Ceredigion.
permalink: /contact/index.html
---
<div class="wrap contact-top">
  <div class="eyebrow eyebrow-red">Contact</div>
  <h1>Let us know what needs doing</h1>
  <p class="lede">Ring, text or fill the form. {{ site.owner }} answers the same day, and coming to look costs nothing.</p>

  <div class="contact-grid">
    <div class="contact-side">
      <h2 class="vh">Other ways to reach us</h2>
      <a class="ccard primary" href="tel:{{ site.phoneLink }}">
        <div class="k">Call</div>
        <div class="v">{{ site.phoneDisplay }}</div>
      </a>
      <a class="ccard" href="sms:{{ site.phoneLink }}">
        <div class="k">Text</div>
        <div class="v sm">{{ site.phoneDisplay }}</div>
        <div class="sub">Photos of the roof help.</div>
      </a>
      <a class="ccard" href="mailto:{{ site.email }}">
        <div class="k">Email</div>
        <div class="v xs">{{ site.email }}</div>
      </a>
      <div class="areabox">
        <div class="t">Where we work</div>
        <p>{{ site.areasLong }}. Further out for larger jobs, just ask.</p>
      </div>
    </div>

    <div class="contact-main">
      <h2 class="vh">Send an enquiry</h2>
      <form name="enquiry" method="POST" data-netlify="true" netlify-honeypot="company" action="/thanks/">
        <input type="hidden" name="form-name" value="enquiry">
        <p hidden><label>Leave this empty: <input name="company"></label></p>

        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" name="name" required autocomplete="name" placeholder="Name">
        </div>
        <div class="field-row">
          <div class="field">
            <label for="c-phone">Phone</label>
            <input id="c-phone" name="phone" type="tel" required autocomplete="tel" placeholder="07&hellip;">
          </div>
          <div class="field">
            <label for="c-email">Email</label>
            <input id="c-email" name="email" type="email" autocomplete="email" placeholder="you@&hellip;">
          </div>
        </div>
        <div class="field">
          <label for="c-addr">Where is the roof?</label>
          <input id="c-addr" name="address" autocomplete="street-address" placeholder="Street, town, postcode">
        </div>
        <div class="field-row">
          <div class="field">
            <label for="c-type">Type of job</label>
            <select id="c-type" name="type">
              <option value="">Not sure yet</option>
              {% for s in site.services %}<option>{{ s.name }}</option>{% endfor %}
              <option>Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="c-when">How soon?</label>
            <select id="c-when" name="when">
              <option value="">Please choose</option>
              <option>It's leaking now</option>
              <option>Within a month</option>
              <option>Next few months</option>
              <option>Just after a price</option>
              <option>No rush</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="c-msg">What's it doing?</label>
          <textarea id="c-msg" name="message" rows="5" placeholder="Slipped slates, damp patch on the ceiling, full re-roof&hellip;"></textarea>
        </div>
        <div class="form-foot">
          <button class="btn btn-red" type="submit">Send enquiry</button>
          <span class="form-note">No newsletters, no passing your details on. See our <a href="/privacy/">privacy policy</a>.</span>
        </div>
      </form>
    </div>
  </div>
</div>
