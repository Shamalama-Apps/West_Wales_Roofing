---
layout: base.njk
---
{% set jobs = collections.carpentry if trade == "Carpentry" else collections.jobs %}
{% set idx = jobs | indexOfUrl(page.url) %}
{% set nextJob = jobs | nextAfterUrl(page.url) %}

<div class="wrap" style="padding-top:28px;display:flex;align-items:center;justify-content:space-between;gap:16px">
  <a class="sec-more" href="{% if trade == "Carpentry" %}/carpentry/{% else %}/work/{% endif %}">&larr; All {% if trade == "Carpentry" %}carpentry{% else %}roofing{% endif %} jobs</a>
  <div style="font:600 12px var(--disp);letter-spacing:.12em;color:var(--grey)">{{ (idx + 1) | pad }} / {{ jobs.length | pad }}</div>
</div>

<div class="wrap job-head">
  <div class="eyebrow eyebrow-red">{{ category }}</div>
  <h1>{{ title }}</h1>
</div>

{%- if before and after %}
<div class="wrap ba">
  <div>
    <div class="shot"><img src="{{ before }}" alt="{{ title }} before the work" sizes="(max-width:560px) 100vw, 50vw" loading="eager"></div>
    <div class="label">Before</div>
  </div>
  <div>
    <div class="shot"><img src="{{ after }}" alt="{{ title }} after the work" sizes="(max-width:560px) 100vw, 50vw" loading="eager"></div>
    <div class="label after">After</div>
  </div>
{%- else %}
{%- set lead = [] %}
{%- if hero %}{% set lead = (lead.push(hero), lead) %}{% endif %}
{%- if before and before != hero %}{% set lead = (lead.push(before), lead) %}{% endif %}
{%- if after and after != hero %}{% set lead = (lead.push(after), lead) %}{% endif %}
{%- if lead.length %}
<div class="wrap ba{% if lead.length == 1 %} ba-single{% endif %}">
  {%- for img in lead %}
  <div>
    <div class="shot"><img src="{{ img }}" alt="{{ title }}" sizes="{% if lead.length == 1 %}(max-width:900px) 100vw, 1140px{% else %}(max-width:560px) 100vw, 50vw{% endif %}" loading="eager"></div>
  </div>
  {%- endfor %}
{%- endif %}
{%- endif %}


<div class="wrap job-body">
  <div>
    <p class="lede">{{ overview }}</p>
    <div class="writeup">{{ content | safe }}</div>
  </div>
  <h2 class="vh">Job details</h2>
  <dl class="spec">
    {% if system %}<div class="row"><dt>Roof system</dt><dd>{{ system }}</dd></div>{% endif %}
    {% if size %}<div class="row"><dt>Job size</dt><dd>{{ size }}</dd></div>{% endif %}
    {% if duration %}<div class="row"><dt>Duration</dt><dd>{{ duration }}</dd></div>{% endif %}
    {% if location %}<div class="row"><dt>Location</dt><dd>{{ location }}</dd></div>{% endif %}
    {% if role %}<div class="row"><dt>Will's part</dt><dd>{{ role }}</dd></div>{% endif %}
  </dl>
</div>

{% if gallery and gallery.length %}
<div class="wrap gallery">
  <h2 class="gallery-head">On the job</h2>
  <div class="gallery-grid">
    {% for shot in gallery %}
    <div class="shot"><img src="{{ shot.image }}" alt="{{ shot.caption or title }}" sizes="(max-width:900px) 50vw, 280px"></div>
    {% endfor %}
  </div>
</div>
{% endif %}

<a class="wrap next-job" href="{{ nextJob.url }}">
  <div class="row">
    <div>
      <div class="eyebrow">Next job</div>
      <h2 class="t"><span class="vh">Next job: </span>{{ nextJob.data.title }}</h2>
    </div>
    <div class="arrow">&rarr;</div>
  </div>
</a>

<section class="cta" style="margin-top:56px">
  <div class="wrap cta-in">
    <div>
      <h2>Want work like this on your roof?</h2>
      <p>Ring and {{ site.owner }} answers the same day. Looking costs nothing.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-white" href="tel:{{ site.phoneLink }}">Call {{ site.phoneDisplay }}</a>
      <a class="btn btn-ghost" href="/contact/">Send an enquiry</a>
    </div>
  </div>
</section>
