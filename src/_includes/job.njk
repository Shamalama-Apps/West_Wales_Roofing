---
layout: base.njk
---
{% set jobs = collections.carpentry if trade == "Carpentry" else collections.jobs %}
{% set idx = jobs | indexOfUrl(page.url) %}
{% set nextJob = jobs | nextAfterUrl(page.url) %}

<div class="wrap" style="padding-top:28px;display:flex;align-items:center;justify-content:space-between;gap:16px">
  <a class="sec-more" href="{% if trade == "Carpentry" %}/carpentry/{% else %}/work/{% endif %}">&larr; All {% if trade == "Carpentry" %}carpentry{% else %}roofing{% endif %} jobs</a>
  <div style="font:600 12px var(--disp);letter-spacing:.12em;color:var(--grey)">{{ (idx + 1) | pad }} / {{ jobs.length | pad }}</div>
</div>

<div class="wrap job-head">
  <div class="eyebrow eyebrow-red">{{ category }}</div>
  <h1>{{ title }}</h1>
</div>

{#- Two page shapes. A real before and after deserves the pair shown large and
    equal; anything else reads better with one photo beside the job details. -#}
{%- set showPair = beforeAfter and before and after %}

{%- if showPair %}
<div class="wrap ba">
  <div>
    <div class="shot"><img src="{{ before }}" alt="{{ title }} before the work" sizes="(max-width:560px) 100vw, 560px" loading="eager"></div>
    <div class="label">Before</div>
  </div>
  <div>
    <div class="shot"><img src="{{ after }}" alt="{{ title }} after the work" sizes="(max-width:560px) 100vw, 560px" loading="eager"></div>
    <div class="label after">After</div>
  </div>
</div>

<div class="wrap job-body">
  <div>
    <p class="lede">{{ overview }}</p>
    <div class="writeup">{{ content | safe }}</div>
  </div>
  <div>
    <h2 class="vh">Job details</h2>
    {% include "spec.njk" %}
  </div>
</div>

{%- else %}
{%- set lead = [] %}
{%- if hero %}{% set lead = (lead.push(hero), lead) %}{% endif %}
{%- if before and before != hero %}{% set lead = (lead.push(before), lead) %}{% endif %}
{%- if after and after != hero %}{% set lead = (lead.push(after), lead) %}{% endif %}

<div class="wrap job-top">
  <div class="job-lead{% if lead.length > 1 %} job-lead-pair{% endif %}">
    {%- for img in lead %}
    <div>
      <div class="shot"><img src="{{ img }}" alt="{{ title }}" sizes="(max-width:900px) 100vw, {% if lead.length > 1 %}330{% else %}680{% endif %}px" loading="eager"></div>
    </div>
    {%- endfor %}
  </div>
  <div class="job-facts">
    <h2>Job details</h2>
    {% include "spec.njk" %}
  </div>
</div>

<div class="wrap job-desc">
  <p class="lede">{{ overview }}</p>
  <div class="writeup">{{ content | safe }}</div>
</div>
{%- endif %}

{% if gallery and gallery.length %}
<div class="wrap gallery">
  {#- The photos live in the dialog, so with JavaScript they are downloaded only
      when someone opens it. Without JavaScript the noscript block renders the
      same photos inline instead, so they are never unreachable. -#}
  <button type="button" class="btn btn-line gallery-open" data-gallery-open hidden>
    {% if gallery.length == 1 %}See the photo from this job{% else %}See all {{ gallery.length }} photos from this job{% endif %}
  </button>

  <dialog class="lightbox" data-gallery aria-label="Photographs from {{ title }}">
    <div class="lightbox-bar">
      <span class="lightbox-title">{{ title }}</span>
      <button type="button" class="lightbox-close" data-gallery-close aria-label="Close photographs">&times;</button>
    </div>
    <div class="lightbox-scroll">
      {% include "gallery-items.njk" %}
    </div>
  </dialog>

  <noscript>
    <h2 class="gallery-head">On the job</h2>
    <div class="gallery-static">
      {% include "gallery-items.njk" %}
    </div>
  </noscript>
</div>
{% endif %}

<a class="wrap next-job" href="{{ nextJob.url }}">
  <div class="row">
    <div>
      <div class="eyebrow">Next job</div>
      <h2 class="t"><span class="vh">Next job: </span>{{ nextJob.data.title }}</h2>
    </div>
    <div class="arrow">&rarr;</div>
  </div>
</a>

<section class="cta" style="margin-top:56px">
  <div class="wrap cta-in">
    <div>
      <h2>Want work like this on your roof?</h2>
      <p>Ring and {{ site.owner }} answers the same day. Looking costs nothing.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-white" href="tel:{{ site.phoneLink }}">Call {{ site.phoneDisplay }}</a>
      <a class="btn btn-ghost" href="/contact/">Send an enquiry</a>
    </div>
  </div>
</section>
